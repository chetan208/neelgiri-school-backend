// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TeacherRole{
  Teacher
  Admin
  Owner

}

model Teacher {
  id            Int      @id @default(autoincrement())
  name          String?
  email         String?  @unique
  password      String?
  subject       String?
  qualification String?
  imageUrl      String?
  imagePublicId String?
  role          TeacherRole @default(Teacher)
  isPrincipal   Boolean? @default(false)
  bio           String?
  otp           String?
  otpExpiry     DateTime?
  isVerified    Boolean? @default(false)
  createdAt     DateTime @default(now())
}



model HeroSlider {
  id              Int      @id @default(autoincrement())
  backgroundImage String
  tagline         String?
  titlePart1      String?
  titlePart2      String?
  description     String?  @db.Text
  btn1Label       String?
  btn1Url         String?
  btn2Label       String?
  btn2Url         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SchoolStat {
  id        Int      @id @default(autoincrement())
  iconName  String?
  statValue String
  statLabel String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notice {
  id              Int      @id @default(autoincrement())
  type            String   // "Urgent", "Academic", "Careers"
  title           String
  description     String   @db.Text
  documentUrl       String
  documentPublicId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PYQ {
  id        Int      @id @default(autoincrement())
  className     String?   // E.g., "12", "11"
  subject   String?   // E.g., "Physics", "Chemistry"
  year      String?   // E.g., "2025", "2024"
  term      String?   // E.g., "Board Exam", "Final Term"
  fileUrl   String?   // Cloudinary ka secure PDF URL yahan save hoga
  filePublicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pyqs")
}

enum AdmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Admission {
  id          String   @id
  studentName String
  FatherName  String
  MotherName  String
  dob         DateTime
  targetClass String
  address     String   @db.Text
  phoneNumber String
  email       String
  year        String
  status      AdmissionStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("admissions")
}

model AdmissionSetting {
  id          String   @id @default(uuid())
  isOpen      Boolean  @default(false)
  activeYear  String   @unique
  updatedAt   DateTime @updatedAt

  @@map("admission_settings")
}

enum mediaType{
  video
  image
}

model MediaGallery {
  id         String   @id @default(uuid())
  title      String?
  mediaType  mediaType 
  url        String
  publicId   String?  
  
  // Relation Fields
  categoryId String  
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt]) 
}

model Category {
  id        String          @id @default(uuid()) 
  name      String          @unique 
  media     MediaGallery[]  
  createdAt DateTime        @default(now())
}