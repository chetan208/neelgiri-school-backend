generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Teacher {
  id            String      @id @default(uuid())
  name          String?
  email         String?     @unique
  password      String?
  subject       String?
  qualification String?
  imageUrl      String?
  imagePublicId String?
  cloudName     String?
  role          TeacherRole @default(Teacher)
  isPrincipal   Boolean?    @default(false)
  bio           String?
  otp           String?
  otpExpiry     DateTime?
  isVerified    Boolean?    @default(false)
  createdAt     DateTime    @default(now())
  phoneNumber   String?
}

model HeroSlider {
  id              Int      @id @default(autoincrement())
  backgroundImage String
  tagline         String?
  titlePart1      String?
  titlePart2      String?
  description     String?
  btn1Label       String?
  btn1Url         String?
  btn2Label       String?
  btn2Url         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SchoolStat {
  id        Int      @id @default(autoincrement())
  iconName  String?
  statValue String
  statLabel String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notice {
  id               Int      @id @default(autoincrement())
  type             String
  title            String
  description      String
  documentUrl      String
  documentPublicId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  cloudName        String?
}

model PYQ {
  id           Int      @id @default(autoincrement())
  className    String?
  subject      String?
  year         String?
  term         String?
  fileUrl      String?
  filePublicId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cloudName    String?

  @@map("pyqs")
}

model Admission {
  id          String          @id
  studentName String
  FatherName  String
  MotherName  String
  dob         DateTime
  targetClass String
  address     String
  phoneNumber String
  email       String
  year        String
  status      AdmissionStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("admissions")
}

model AdmissionSetting {
  id         String   @id @default(uuid())
  isOpen     Boolean  @default(false)
  activeYear String   @unique
  updatedAt  DateTime @updatedAt

  @@map("admission_settings")
}

model MediaGallery {
  id         String    @id @default(uuid())
  title      String?
  mediaType  mediaType
  url        String
  publicId   String?   @unique
  order      Int       @default(0)
  categoryId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  cloudName  String?
  category   Category  @relation(fields: [categoryId], references: [id])

  @@index([createdAt])
}

model Category {
  id        String         @id @default(uuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  media     MediaGallery[]
}

model contactUs {
  id          String @id @default(uuid())
  name        String
  phoneNumber String
  email       String
  message     String
}

model CalendarEvent {
  id          String    @id @default(uuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  type        String    @default("holiday")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("calendar_events")
}

model TopResult {
  id            String   @id @default(uuid())
  studentName   String
  className     String
  marks         String
  parentsName   String
  imageUrl      String?
  imagePublicId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  cloudName     String?

  @@map("top_results")
}

model Student {
  id              String         @id @default(uuid())
  name            String
  fatherName      String
  motherName      String?
  dateOfAdmission DateTime?
  cardNo          String
  contactNo       String
  station         String?
  classId         String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sessionId       String
  feeStructures   FeeStructure[]
  studentclass    Class          @relation(fields: [classId], references: [id])
  session         Session        @relation(fields: [sessionId], references: [id])

  @@unique([cardNo, sessionId])
  @@map("students")
}

model Class {
  id            String    @id @default(uuid())
  className     String    @unique
  admissionFee  Decimal   @default(0) @db.Decimal(10, 2)
  tuitionFee    Decimal   @default(0) @db.Decimal(10, 2)
  examFee       Decimal   @default(0) @db.Decimal(10, 2)
  computerFee   Decimal   @default(0) @db.Decimal(10, 2)
  ptmFine       Decimal   @default(0) @db.Decimal(10, 2)
  buildingFund  Decimal   @default(0) @db.Decimal(10, 2)
  annualCharges Decimal   @default(0) @db.Decimal(10, 2)
  tieBeltBooks  Decimal   @default(0) @db.Decimal(10, 2)
  students      Student[]

  @@map("classes")
}

model FeeStructure {
  id               String    @id @default(uuid())
  studentId        String
  month            String
  studentClass     String?
  admissionFee     Decimal   @default(0) @db.Decimal(10, 2)
  tuitionFee       Decimal   @default(0) @db.Decimal(10, 2)
  examFee          Decimal   @default(0) @db.Decimal(10, 2)
  schoolBusCharges Decimal   @default(0) @db.Decimal(10, 2)
  ptmFine          Decimal   @default(0) @db.Decimal(10, 2)
  computerFee      Decimal   @default(0) @db.Decimal(10, 2)
  tieBeltBooks     Decimal   @default(0) @db.Decimal(10, 2)
  buildingFund     Decimal   @default(0) @db.Decimal(10, 2)
  annualCharges    Decimal   @default(0) @db.Decimal(10, 2)
  total            Decimal   @db.Decimal(10, 2)
  status           FeeStatus @default(PENDING)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments         Payment[]

  @@unique([studentId, month])
  @@map("fee_structures")
}

model Payment {
  id             String       @id @default(uuid())
  feeStructureId String
  amountPaid     Decimal      @db.Decimal(10, 2)
  paymentMode    PaymentMode
  date           DateTime     @default(now())
  createdAt      DateTime     @default(now())
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Session {
  id        String    @id @default(uuid())
  year      String    @unique
  createdAt DateTime  @default(now())
  students  Student[]

  @@map("sessions")
}

model TransportFee {
  id        String   @id @default(uuid())
  station   String   @unique
  amount    Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt

  @@map("transport_fees")
}

model ClassMonthlyFee {
  id            String   @id @default(uuid())
  className     String
  monthName     String
  admissionFee  Decimal  @default(0) @db.Decimal(10, 2)
  tuitionFee    Decimal  @default(0) @db.Decimal(10, 2)
  examFee       Decimal  @default(0) @db.Decimal(10, 2)
  computerFee   Decimal  @default(0) @db.Decimal(10, 2)
  tieBeltBooks  Decimal  @default(0) @db.Decimal(10, 2)
  ptmFine       Decimal  @default(0) @db.Decimal(10, 2)
  buildingFund  Decimal  @default(0) @db.Decimal(10, 2)
  annualCharges Decimal  @default(0) @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([className, monthName])
  @@map("class_monthly_fees")
}

model WhatsAppSession {
  id        String   @id
  sessionId String
  category  String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whatsapp_sessions")
}

model FeeAutomationSetting {
  id         String   @id @default("singleton")
  isEnabled  Boolean  @default(false)
  startDay   Int      @default(1)
  windowDays Int      @default(3)
  updatedAt  DateTime @updatedAt

  @@map("fee_automation_settings")
}

model FeeAutomationLog {
  id        String   @id @default(uuid())
  studentId String
  monthStr  String
  status    String
  createdAt DateTime @default(now())

  @@unique([studentId, monthStr])
  @@map("fee_automation_logs")
}

enum TeacherRole {
  Teacher
  Admin
  Owner
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum AdmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum mediaType {
  video
  image
}

enum FeeStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

enum PaymentMode {
  CASH
  UPI
}
